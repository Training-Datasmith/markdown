<?xml version="1.0" encoding="utf-8"?>
<phpunit bootstrap="./tests/bootstrap.php"
		colors="true"
		convertErrorsToExceptions="true"
		convertNoticesToExceptions="true"
		convertWarningsToExceptions="true"
		stopOnFailure="false">
		<php>
			<ini name="error_reporting" value="-1"/>
			<ini name="display_errors" value="1"/>
		</php>
		<testsuites>
			<testsuite name="Markdown Test Suite">
				<file>./tests/Parser_Test.php</file>

				<file>./tests/Markdown_Test.php</file>
				<file>./tests/Markdown_OL_Start_Num_Test.php</file>
				
				<file>./tests/Github_Markdown_Test.php</file>
				
				<file>./tests/Markdown_Extra_Test.php</file>
			</testsuite>
		</testsuites>
</phpunit>

